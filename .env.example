# ============================================================
# Pick ONE generation provider via FDI_LLM_PROVIDER below.
# ============================================================

# ---------- Option A: OpenAI (you have this key) ----------
FDI_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
FDI_OPENAI_MODEL=gpt-5.4-mini          # cheap, high-volume default
FDI_OPENAI_HEAVY_MODEL=gpt-5.4         # for hard multi-doc analysis

# Use OpenAI for embeddings too (recommended if using OpenAI for generation):
FDI_EMBED_PROVIDER=openai
FDI_OPENAI_EMBED_MODEL=text-embedding-3-small   # or text-embedding-3-large

# ---------- Option B: Anthropic ----------
# FDI_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# FDI_LLM_MODEL=claude-sonnet-4-6
# FDI_LLM_HEAVY_MODEL=claude-opus-4-8

# ---------- Embedding alternatives ----------
# "local"  = sentence-transformers, fully offline, no key (default)
# "openai" = text-embedding-3-* (set above)
# "voyage" = Voyage AI finance-tuned model
# FDI_EMBED_PROVIDER=local
# FDI_LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
# FDI_VOYAGE_MODEL=voyage-finance-2
# VOYAGE_API_KEY=pa-...

# ---------- Shared generation params ----------
FDI_LLM_MAX_TOKENS=1500
FDI_LLM_TEMPERATURE=0.0

# ---------- Chunking ----------
FDI_CHUNK_TOKENS=550
FDI_CHUNK_OVERLAP=80
FDI_TABLE_TOKENS=900

# ---------- Retrieval ----------
FDI_TOP_K=8
FDI_FINAL_K=5
FDI_HYBRID=true
FDI_KEYWORD_WEIGHT=0.35
FDI_RERANK=false
